{
  "registry_id": "CLARA_BASELINES_V1",
  "status": "FROZEN_FOR_S06_IMPLEMENTATION",
  "selection_scope": "nested_leave_one_source_zone_out_within_each_outer_fold",
  "heldout_zone_use": "final_evaluation_only",
  "common_information_contract": {
    "release_time_state_fields": [
      "predictor",
      "horizon_group",
      "target_coverage",
      "ramp_state",
      "rolling_state",
      "raw_width_state"
    ],
    "actions": [
      "Static",
      "ACI",
      "AgACI",
      "EnbPI_RH"
    ],
    "strict_delayed_feedback": true,
    "same_errf_formula": true,
    "same_clipping_policy": true,
    "same_event_complete_cases": true
  },
  "inner_validation": {
    "fold_unit": "source_zone",
    "primary_objective": "zone_balanced_mean_ERRF_proxy_per_mw",
    "feasibility_constraints": {
      "mean_coverage_gap_minimum": -0.02,
      "tuwr_maximum": 0.35
    },
    "no_feasible_configuration_rule": "minimum_ERRF_then_smallest_coverage_shortfall_then_simplest_configuration",
    "general_tie_order": [
      "lower_primary_objective",
      "lower_complexity",
      "lexicographic_configuration_id"
    ]
  },
  "mandatory_fixed_and_ablation_baselines": [
    {
      "id": "FixedStatic",
      "type": "fixed_action",
      "action": "Static"
    },
    {
      "id": "FixedACI",
      "type": "fixed_action",
